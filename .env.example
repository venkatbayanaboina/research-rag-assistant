# 🔐 Environment Variables Template
# Copy this file to .env and fill in your active API keys

# OpenRouter API Key (primary: generator, judges, failover)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini API Key (optional: alternative primary provider)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: pin the OpenRouter model rotation without code changes
# (comma-separated slugs; default order is benchmark-driven, see ADR-007)
# OPENROUTER_MODELS=z-ai/glm-5.3-flash,nvidia/nemotron-3.5-lightning:free

# Optional: judge with a different model family than the generator
# (any OpenRouter slug; leave empty to use the rotation head)
# JUDGE_MODEL=google/gemini-2.5-flash
